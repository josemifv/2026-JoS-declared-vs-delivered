# T29: declaraciones T23/R02 y clusters/modulos_declarados/lusitania.json.
CLUSTER=lusitania
SSH_ALIAS=computaex
PARTITION=lusitania
ENV_PREFIX=LUSITANIA
QOS=
DECLARED_NODES=35
DECLARED_CORES=20
# T46: las consultas no muestran un tope menor; se aplica la regla de la orden y se conserva la calibración aceptada de 8 nodos (753515).
CALIB_NODES=8
GNU_MODULES=(gcc/gcc-11.2.0 openmpi/openmpi-4.1.2-gcc11.2.0 ucx/ucx-1.12.0)
# T40: Intel MPI con compiladores GNU del perfil; mpif90 debe mostrar gfortran del módulo GNU.
INTEL_MODULES=(gcc/gcc-11.2.0 intel-oneapi-24/compiler intel-oneapi-24/mpi)
MARCH=native
# Ruta/version del login verificadas: informes/tareas/T29/python-lusitania.txt.
PYTHON_DISCOVERY=/lusitania_apps/python/python-3.10.6/bin/python3
RPN=POR_DETERMINAR
CPU_MAP=POR_DETERMINAR
GNU_TRANSPORTS=POR_DETERMINAR
INTEL_TRANSPORTS=POR_DETERMINAR
NPB_CLASS=POR_DETERMINAR
