# Copiar como clusters/local.env y rellenar. local.env NO se versiona.
# Solo valores locales: usuarios, cuentas y rutas. Nunca contraseñas ni claves.

# Turgalium
TURGALIUM_USER=
TURGALIUM_ACCOUNT=
TURGALIUM_WORKDIR=
TURGALIUM_SCRATCH=
TURGALIUM_REPO=

# Xula
XULA_USER=
XULA_ACCOUNT=
XULA_WORKDIR=
XULA_SCRATCH=
XULA_REPO=

# Lusitania
LUSITANIA_USER=
LUSITANIA_ACCOUNT=
LUSITANIA_WORKDIR=
LUSITANIA_SCRATCH=
LUSITANIA_REPO=

# Módulos por stack (los usan las plantillas de experiments/; rellenar según
# clusters/<cluster>.md tras el descubrimiento). Ejemplos:
# MODULES_GCC_OMPI="gcc/13 openmpi/4.1 ucx/1.16"
# MODULES_ONEAPI_IMPI="intel/2024.1 impi/2021.11"
# MODULES_GPU="cuda/12.4 gcc/13"
MODULES_GCC_OMPI=
MODULES_ONEAPI_IMPI=
MODULES_GPU=

# Descubrimiento (discovery/collect_node.py §3.5): módulos a sondear por nodo.
# DISCOVERY_CMMSE_MODULES: los del stack del CMMSE, para comprobar disponibilidad (R5).
DISCOVERY_MODULES=
DISCOVERY_CMMSE_MODULES=
