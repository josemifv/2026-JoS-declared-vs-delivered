# T53 parte C: perfil de Turgalium cpu36c para los scripts portables. Sin usuario, cuenta ni
# rutas personales: REPO y SCRATCH salen de TURGALIUM_REPO y TURGALIUM_SCRATCH de clusters/local.env.
# Criba de cpu36c (experiments/equivalencia.sh): 36 CPUs declaradas por Slurm, pila GNU de abajo.
# Como en los lanzamientos anteriores de Turgalium, no se pasa --account ni --qos.
CLUSTER=turgalium
SSH_ALIAS=turgalium
PARTITION=cpu36c
ENV_PREFIX=TURGALIUM
QOS=
DECLARED_NODES=40
DECLARED_CORES=36
GNU_MODULES=(openmpi_gcc/5.0.5 ucx/1.9.0)
# Binario STREAM de la criba (relativo a SCRATCH) y su sha256 fijado por la persona (opción b,
# 2026-10-18): el binario no tiene sidecar y no se genera.
STREAM_BIN_REL=src/stream/stream_c
STREAM_BIN_SHA256=89bf099493eb976407021b8881adfbea3c2b78740e15d0c571c9bd2456b8744f
STREAM_ARRAY_SIZE=40000000
