# T29: declaraciones T22/R02 y clusters/modulos_declarados/xula.json.
CLUSTER=xula
SSH_ALIAS=xula
PARTITION=xula4
ENV_PREFIX=XULA
# T40/C4.txt: a admite la talla de 8 nodos; c limita a 3. Sin límite de envíos.
QOS=a
DECLARED_NODES=28
DECLARED_CORES=112
CALIB_NODES=2
GNU_MODULES=(gcc-13.1.0-gcc-8.5.0-ueufrru openmpi-4.1.8-gcc-13.1.0-mtnpd5o ucx-1.14.0-gcc-13.1.0-4t6t2iw)
# T40: Intel MPI con compiladores GNU del perfil; mpif90 debe mostrar gfortran del módulo GNU.
INTEL_MODULES=(gcc-13.1.0-gcc-8.5.0-ueufrru intel-oneapi-compilers-2023.1.0-gcc-8.5.0-6g2jkiv intel-oneapi-mpi-2021.9.0-oneapi-2023.1.0-alz6lst)
MARCH=native
# Ruta/version del login verificadas: informes/tareas/T29/python-xula.txt.
PYTHON_DISCOVERY=<home>/spack/opt/spack/linux-rocky8-icelake/gcc-10.2.0/python-3.10.10-xun5v6mui3qkshqwl7wb6puvzvv6ukyy/bin/python3
RPN=POR_DETERMINAR
CPU_MAP=POR_DETERMINAR
GNU_TRANSPORTS=POR_DETERMINAR
INTEL_TRANSPORTS=POR_DETERMINAR
NPB_CLASS=POR_DETERMINAR
